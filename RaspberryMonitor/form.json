{
  "elements": [
    {
      "type": "Label",
      "caption": "Raspberry Monitor 1.7 – MQTT-Broker-Protokolltest, nur lesend"
    },
    {
      "type": "List",
      "name": "Devices",
      "caption": "Überwachte Rechner",
      "rowCount": 5,
      "add": true,
      "delete": true,
      "columns": [
        {
          "name": "name",
          "caption": "Bezeichnung",
          "width": "180px",
          "add": "Neuer Raspberry",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "ip",
          "caption": "IP-Adresse",
          "width": "160px",
          "add": "192.168.178.90",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "mode",
          "caption": "Modus",
          "width": "120px",
          "add": "ssh",
          "edit": {
            "type": "Select",
            "options": [
              {
                "caption": "SSH",
                "value": "ssh"
              },
              {
                "caption": "Lokal",
                "value": "local"
              }
            ]
          }
        },
        {
          "name": "user",
          "caption": "SSH-Nutzer",
          "width": "120px",
          "add": "pi",
          "edit": {
            "type": "ValidationTextBox"
          }
        },
        {
          "name": "key",
          "caption": "Schlüsselpfad (auf Symcon)",
          "width": "260px",
          "add": "/root/.ssh/symcon_zigbee",
          "edit": {
            "type": "ValidationTextBox"
          }
        }
      ]
    },
    {
      "type": "NumberSpinner",
      "name": "ScanStart",
      "caption": "Netzwerksuche: Startadresse im lokalen /24 (32 IPs pro Suchlauf)",
      "minimum": 1,
      "maximum": 223
    },
    {
      "type": "NumberSpinner",
      "name": "Interval",
      "caption": "Aktualisierung (Minuten)",
      "minimum": 1,
      "maximum": 1440
    },
    {
      "type": "Label",
      "caption": "Die HTML-SDK-Kachel bietet Hinzufügen, Prüfen und eine begrenzte SSH-Netzwerksuche. Neustarts/Updates sind noch gesperrt."
    },
    {
      "type": "CheckBox",
      "name": "AllowRestart",
      "caption": "Neustarts nach Sicherheitsbestätigung erlauben (nur für vertrauenswürdige Visualisierungsnutzer; Remote benötigt begrenzte sudo-Rechte)"
    },
    {
      "type": "Label",
      "caption": "Updates prüfen liest nur APT-Listen. Updateinstallationen und Debian-Versionswechsel sind aus Sicherheitsgründen noch nicht freigeschaltet."
    },
    {
      "type": "CheckBox",
      "name": "AllowServiceRestart",
      "caption": "Dienstneustarts nach Bestätigung erlauben (Remote: sudo-Berechtigung nur für Zigbee2MQTT; lokal: symcon)"
    },
    {
      "type": "NumberSpinner",
      "name": "ZigbeeBridgeStatusID",
      "caption": "Bestehende Zigbee2MQTT Bridge Status-Variable (Boolean, derzeit 27220)",
      "minimum": 0
    },
    {
      "type": "NumberSpinner",
      "name": "BridgeFreshnessMinutes",
      "caption": "Maximales Alter einer Bridge-Statusaktualisierung (Minuten)",
      "minimum": 1,
      "maximum": 1440
    },
    {
      "type": "ValidationTextBox",
      "name": "MQTTBrokerIP",
      "caption": "MQTT-Broker-IP (LAN)"
    },
    {
      "type": "NumberSpinner",
      "name": "MQTTBrokerPort",
      "caption": "MQTT-Broker-Port",
      "minimum": 1,
      "maximum": 65535
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "Alle Geräte jetzt prüfen",
      "onClick": "SRM_Refresh($id);"
    },
    {
      "type": "Button",
      "caption": "SSH-Ports im Teilnetz suchen",
      "onClick": "IPS_RequestAction($id, \"ScanNow\", true);"
    }
  ]
}
